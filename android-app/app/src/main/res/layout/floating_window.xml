<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- ═══════ BURBUJA (64dp) ═══════ -->
    <FrameLayout
        android:id="@+id/collapsedRoot"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_bubble"
        android:elevation="8dp"
        android:visibility="visible">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="⚡"
            android:textSize="28sp"
            android:textColor="#FFFFFF"/>
    </FrameLayout>

    <!-- ═══════ PANEL EXPANDIDO ═══════ -->
    <FrameLayout
        android:id="@+id/expandedRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:elevation="12dp"
        android:clipToOutline="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panelContent"
            android:layout_width="320dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HEADER compacto (32dp, sin botones inferiores) -->
            <LinearLayout
                android:id="@+id/dragHandle"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:background="#6200EE"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚡ App"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="12sp"/>

                <!-- Botón COPIAR TEXTO (nuevo) -->
<Button
    android:id="@+id/btnCopyText"
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:text="📋"
    android:textColor="#FFFFFF"
    android:textSize="14sp"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:minWidth="0dp"
    android:padding="0dp"/>
                
                <!-- Botón para ACTIVAR/DESACTIVAR resize -->
                <Button
                    android:id="@+id/btnResizeToggle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="⤢"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:minWidth="0dp"
                    android:padding="0dp"/>

                <!-- Botón colapsar (volver a burbuja) -->
                <Button
                    android:id="@+id/btnCollapse"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="↓"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:minWidth="0dp"
                    android:padding="0dp"/>

                <!-- Botón cerrar (apagar servicio) -->
                <Button
                    android:id="@+id/btnClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="✖"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:minWidth="0dp"
                    android:padding="0dp"/>
            </LinearLayout>

            <!-- WebView con tu app (sin barra inferior) -->
            <WebView
                android:id="@+id/floatingWebView"
                android:layout_width="match_parent"
                android:layout_height="380dp"/>
        </LinearLayout>

        <!-- GRIP de resize (esquina inferior-derecha, oculto por defecto) -->
        <FrameLayout
            android:id="@+id/resizeGrip"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:background="#AA000000"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="⇲"
                android:textColor="#FFFFFF"
                android:textSize="20sp"/>
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
